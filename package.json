{
    "name": "underhell-elements",
    "displayName": "地狱之下 · 元素工具",
    "description": "为 UnderHell / UHTemp 的 Typst 正文提供元素系统支持:悬停/跳转/诊断/高亮,及补全/清理/排序/改名。",
    "version": "0.1.0",
    "publisher": "kych-net",
    "author": "跨越晨昏",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "license": "MIT",
    "main": "./out/extension.js",
    "keywords": [
        "typst",
        "underhell",
        "uhtemp",
        "elements",
        "元素系统"
    ],
    "activationEvents": [
        "workspaceContains:**/*.typ",
        "workspaceContains:**/元素系统.csv",
        "onView:underhellElementExplorer.view"
    ],
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "underhellElementExplorer",
                    "title": "元素管理",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "underhellElementExplorer": [
                {
                    "type": "webview",
                    "id": "underhellElementExplorer.view",
                    "name": "元素表"
                }
            ]
        },
        "commands": [
            { "command": "underhell.elements.scan", "title": "元素:扫描诊断" },
            { "command": "underhell.elements.complement", "title": "元素:补全缺失到CSV" },
            { "command": "underhell.elements.cleanup", "title": "元素:清理CSV孤儿" },
            { "command": "underhell.elements.sort", "title": "元素:按文档顺序排序CSV" },
            { "command": "underhell.elements.rename", "title": "元素:重命名ID" },
            { "command": "underhell.elements.refresh", "title": "元素:刷新缓存" }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorLangId == typst",
                    "command": "underhell.elements.rename",
                    "group": "9_underhell"
                }
            ],
            "commandPalette": [
                { "command": "underhell.elements.rename", "when": "editorHasSelection" }
            ]
        },
        "semanticTokenTypes": [
            {
                "id": "elementId",
                "superType": "variable",
                "description": "元素系统 id"
            }
        ],
        "semanticTokenScopes": [
            { "scopes": { "elementId": ["variable.name"] } }
        ],
        "configuration": {
            "title": "地狱之下元素",
            "properties": {
                "underhell.elements.repoRoot": {
                    "type": "string",
                    "default": "",
                    "description": "可选覆盖仓库根(含 内容/ 的目录)。留空则自动从工作区探测。"
                }
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kych-net/UHVS"
    },
    "bugs": {
        "url": "https://github.com/kych-net/UHVS/issues"
    },
    "homepage": "https://github.com/kych-net/UHVS#readme",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "pretest": "npm run compile && npm run lint",
        "test": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "eslint": "^9.25.1",
        "typescript": "^5.8.3",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^2.32.0"
    }
}
